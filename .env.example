# Токен от @BotFather (никому не показывайте!)
BOT_TOKEN=

# Telegram ID администраторов через запятую, например: 123456789,987654321
ADMIN_IDS=

POSTGRES_DB=jac_parts
POSTGRES_USER=jac_bot
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Можно оставить пустым — соберётся автоматически из POSTGRES_*
DATABASE_URL=

LOG_LEVEL=INFO

# Часовой пояс для времени заказов
TIMEZONE=Asia/Tashkent

# --- Веб-панель (только локальная сеть) ---
# Адрес, который бот покажет сотрудникам вместе с логином (IP сервера в локальной сети)
WEB_URL=http://192.168.48.103
# Порт на сервере и IP, на котором слушать (0.0.0.0 — все сетевые карты сервера)
WEB_PORT=80
WEB_BIND=0.0.0.0
# Название панели (шапка, страница входа, вкладка браузера)
PANEL_NAME=JAC Motors Parts
# Необязательно: имя бота без @ (для ссылок-приглашений). Если пусто — панель спросит у Telegram
BOT_USERNAME=
# Необязательно: ключ подписи входа. Если пусто — берётся из BOT_TOKEN
WEB_SECRET=
