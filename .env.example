# Токен от @BotFather (никому не показывайте!)
BOT_TOKEN=

# Telegram ID администраторов через запятую, например: 123456789,987654321
ADMIN_IDS=

POSTGRES_DB=jac_parts
POSTGRES_USER=jac_bot
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Можно оставить пустым — соберётся автоматически из POSTGRES_*
DATABASE_URL=

LOG_LEVEL=INFO

# Часовой пояс для времени заказов
TIMEZONE=Asia/Tashkent

# --- Веб-панель (только локальная сеть) ---
# Адрес, который бот покажет сотрудникам вместе с логином.
# Имя partsbot.jacmotors.uz должно указывать на IP сервера во внутреннем DNS (см. README → HTTPS)
WEB_URL=https://partsbot.jacmotors.uz
# IP, на котором слушать порты 80/443 (0.0.0.0 — все сетевые карты сервера)
WEB_BIND=0.0.0.0
# Название панели (шапка, страница входа, вкладка браузера)
PANEL_NAME=JAC Motors Parts
# Необязательно: имя бота без @ (для ссылок-приглашений). Если пусто — панель спросит у Telegram
BOT_USERNAME=
# Необязательно: ключ подписи входа. Если пусто — берётся из BOT_TOKEN
WEB_SECRET=

# --- Синхронизация остатков с CarSale (сервис sync) ---
# Учётная запись CarSale, под которой бот читает «Список запчастей». Только в этом файле, в GitHub не попадает.
CARSALE_LOGIN=
CARSALE_PASSWORD=
# Как часто синхронизировать, минут (0 — только по кнопке «Синхронизировать сейчас» в панели)
CARSALE_SYNC_MINUTES=30
# Дилеры CarSale, которых не показывать в боте (через запятую)
CARSALE_SKIP_DEALERS=test diler
